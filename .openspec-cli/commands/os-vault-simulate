#!/usr/bin/env bash
# os-vault-simulate — Simulate a Smart Contract against Vault Core API
#   POST /v1/contracts:simulate (streaming NDJSON)
#
# Usage:
#   os-vault-simulate <contract_file> [start_ts] [end_ts] [param_overrides_json] \
#                     [--deposit N] [--payroll] [--deposit-on YYYY-MM-DD] \
#                     [--all-accounts] [--verbose] [--raw]
#
# Examples:
#   os-vault-simulate contracts/savings_product.py
#   os-vault-simulate contracts/savings_product.py 2024-01-01T00:00:00Z 2024-04-01T00:00:00Z
#   os-vault-simulate contracts/fixed_term_deposit.py "" "" '{"maturity_date":"2024-06-01T00:00:00Z"}'
#   os-vault-simulate contracts/cuenta_nomina.py --deposit 1000            # fee actually charged
#   os-vault-simulate contracts/cuenta_nomina.py --deposit 1500 --payroll  # marked as NOMINA
#
# The account is created inside the simulation. TEMPLATE/GLOBAL and INSTANCE
# parameter values are auto-extracted from the contract; override any of them
# with the JSON argument.
#
# The log shows every scheduled event, the postings it generates and the
# running account balances after each one. Consecutive scheduled events that
# move no money are folded into one line (--verbose to expand). --deposit N
# seeds the account first (funded from a throw-away contra account opened
# inside the simulation) so fees / interest have a balance to act on. --raw
# dumps the NDJSON verbatim.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"

source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
os_load_config
os_load_env

CONTRACT_FILE="${1:-}"
if [ -z "${CONTRACT_FILE}" ]; then
    os_print_error "Usage: os-vault-simulate <contract_file> [start_ts] [end_ts] [param_overrides_json]"
    os_print_info  "Example: os-vault-simulate contracts/savings_product.py"
    exit 1
fi

if [ -z "${VAULT_BASE_URL:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
    os_print_error "Missing Vault credentials. Add to .env:"
    os_print_info  "  VAULT_BASE_URL=https://your-vault-instance.com"
    os_print_info  "  VAULT_TOKEN=your_vault_api_token"
    exit 1
fi

export OS_REPO_ROOT

exec "${OS_PYTHON}" "${OS_CLI_LIB}/vault_simulate.py" "$@"
