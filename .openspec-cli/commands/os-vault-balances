#!/usr/bin/bash
# os-vault-balances — Get live balances for a Vault account
# v2: agrega os_load_env/os_load_config, quita curl -f (fallaba en
#     silencio con set -e), captura body/status por separado.
# Usage: os-vault-balances <account_id>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"
source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
os_load_config
os_load_env

ACCOUNT_ID="${1:-}"
[ -z "${ACCOUNT_ID}" ] && { os_print_error "Usage: os-vault-balances <account_id>"; exit 1; }

if [ -z "${VAULT_BASE_URL:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
    os_print_error "Missing Vault credentials. Add VAULT_BASE_URL and VAULT_TOKEN to .env"
    exit 1
fi

os_print_separator
os_print_header "OpenSpec — Vault Account Balances"
os_print_separator
os_print_info "Account: ${ACCOUNT_ID}"

RESULT_FILE=$(mktemp /tmp/os-vault-balances-XXXXXX.json)
trap "rm -f ${RESULT_FILE}" EXIT

HTTP_STATUS=$(curl -s -o "${RESULT_FILE}" -w "%{http_code}" \
    -H "X-Auth-Token: ${VAULT_TOKEN}" \
    -H "Content-Type: application/json" \
    "${VAULT_BASE_URL}/v1/balances/live?account_ids=${ACCOUNT_ID}&page_size=50")

if [ "${HTTP_STATUS}" != "200" ]; then
    os_print_error "Fetching balances failed (HTTP ${HTTP_STATUS}):"
    cat "${RESULT_FILE}" | "${OS_PYTHON}" -m json.tool 2>/dev/null || cat "${RESULT_FILE}"
    exit 1
fi

"${OS_PYTHON}" "${OS_CLI_LIB}/vault_balances_print_result.py" "${RESULT_FILE}"

os_print_separator
