#!/usr/bin/bash
# os-vault-products — List Smart Contract products (product versions) deployed in Vault
# Usage: os-vault-products [--all]
#   (default: only current/active product versions; --all also lists superseded versions)
#
# Vault's GET /v1/product-versions requires a product_id (there is no "list
# versions across all products" call), so the fetch is two-step: list all
# Products, then the version(s) for each one. See vault_products_fetch_and_print.py.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"

source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
os_load_config
os_load_env

ONLY_CURRENT="true"
if [ "${1:-}" = "--all" ]; then
    ONLY_CURRENT="false"
fi

if [ -z "${VAULT_BASE_URL:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
    os_print_error "Missing Vault credentials. Add VAULT_BASE_URL and VAULT_TOKEN to .env"
    exit 1
fi

os_print_separator
os_print_header "OpenSpec — Vault Products"
os_print_separator
os_print_info "Vault URL : ${VAULT_BASE_URL}"
if [ "${ONLY_CURRENT}" = "true" ]; then
    os_print_info "Filter    : current versions only (use --all to include superseded ones)"
else
    os_print_info "Filter    : all versions"
fi
os_print_separator

"${OS_PYTHON}" "${OS_CLI_LIB}/vault_products_fetch_and_print.py" "${VAULT_BASE_URL}" "${VAULT_TOKEN}" "${ONLY_CURRENT}"

os_print_separator
