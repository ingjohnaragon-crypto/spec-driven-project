#!/usr/bin/bash
# os-vault-products — List Smart Contract products (product versions) deployed in Vault
# Usage: os-vault-products [--all]
#   (default: only current/active product versions; --all also lists superseded versions)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"

source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
os_load_config
os_load_env

ONLY_CURRENT="true"
if [ "${1:-}" = "--all" ]; then
    ONLY_CURRENT="false"
fi

if [ -z "${VAULT_BASE_URL:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
    os_print_error "Missing Vault credentials. Add VAULT_BASE_URL and VAULT_TOKEN to .env"
    exit 1
fi

os_print_separator
os_print_header "OpenSpec — Vault Products"
os_print_separator
os_print_info "Vault URL : ${VAULT_BASE_URL}"
if [ "${ONLY_CURRENT}" = "true" ]; then
    os_print_info "Filter    : current versions only (use --all to include superseded ones)"
else
    os_print_info "Filter    : all versions"
fi
os_print_separator

URL="${VAULT_BASE_URL}/v1/product-versions?page_size=50"
if [ "${ONLY_CURRENT}" = "true" ]; then
    URL="${URL}&is_current=true"
fi

RESULT_FILE=$(mktemp /tmp/os-vault-products-XXXXXX.json)
CURL_ERR_FILE=$(mktemp /tmp/os-vault-products-err-XXXXXX)
trap "rm -f ${RESULT_FILE} ${CURL_ERR_FILE}" EXIT

set +e
HTTP_STATUS=$(curl -sS -o "${RESULT_FILE}" -w "%{http_code}" \
    -H "X-Auth-Token: ${VAULT_TOKEN}" \
    -H "Content-Type: application/json" \
    "${URL}" 2>"${CURL_ERR_FILE}")
CURL_EXIT=$?
set -e

if [ "${CURL_EXIT}" != "0" ]; then
    os_print_error "Could not reach Vault (curl exit code ${CURL_EXIT}):"
    cat "${CURL_ERR_FILE}" >&2
    exit 1
fi

if [ "${HTTP_STATUS}" != "200" ]; then
    os_print_error "Fetching products failed (HTTP ${HTTP_STATUS}):"
    cat "${RESULT_FILE}" | "${OS_PYTHON}" -m json.tool 2>/dev/null || cat "${RESULT_FILE}"
    exit 1
fi

"${OS_PYTHON}" "${OS_CLI_LIB}/vault_products_print_result.py" "${RESULT_FILE}"

os_print_separator
