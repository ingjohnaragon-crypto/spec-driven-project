#!/usr/bin/bash
# os-create-ticket — Create a Jira ticket from the terminal
# Usage:
#   os-create-ticket                              # interactive
#   os-create-ticket --hu                         # AI-generated user story
#   os-create-ticket "Fix overdraft" Bug          # quick create
#   os-create-ticket --project OTHER "Title" Task # create in a different project

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"

source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
source "${OS_CLI_LIB}/jira.sh"
source "${OS_CLI_LIB}/agent.sh"
source "${OS_CLI_LIB}/language.sh"

os_load_config
os_load_env
os_load_agent
os_load_language

GENERATE_HU=false
QUICK_SUMMARY=""
QUICK_TYPE=""
PROJECT_KEY_OVERRIDE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --hu) GENERATE_HU=true ;;
    --project|-p)
      shift
      PROJECT_KEY_OVERRIDE="${1:-}"
      ;;
    *)
      if [ -z "$QUICK_SUMMARY" ]; then QUICK_SUMMARY="$1"
      elif [ -z "$QUICK_TYPE" ];   then QUICK_TYPE="$1"
      fi
      ;;
  esac
  shift
done

PROJECT_KEY="${PROJECT_KEY_OVERRIDE:-${JIRA_PROJECT_KEY:-KAN}}"

os_divider
os_label "  OpenSpec — Create Jira Ticket"
os_divider
os_info "Project : $PROJECT_KEY"
os_info "Mode    : $([ "$GENERATE_HU" = true ] && echo 'AI User Story (--hu)' || echo 'Manual')"
os_divider

# ── Collect input ─────────────────────────────────────────────
if [ -n "$QUICK_SUMMARY" ]; then
  SUMMARY="$QUICK_SUMMARY"
  TYPE="${QUICK_TYPE:-Task}"
else
  printf "Summary    : "; read -r SUMMARY
  printf "Type [Story/Bug/Task] (default: Story): "; read -r TYPE
  TYPE="${TYPE:-Story}"
fi

# ── Generate user story with AI if --hu ──────────────────────
if [ "$GENERATE_HU" = "true" ]; then
  os_step "Generating user story with AI..."

  if [ "${OS_ACTIVE_LANGUAGE:-en}" = "es" ]; then
    HU_TEMPLATE="Escribe SOLO el contenido de la historia (sin preámbulos ni explicaciones).
Usa este formato exacto, con lenguaje claro y fácil de leer en Jira:

## Historia de usuario
Como [rol], quiero [capacidad], para [beneficio].

## Contexto
2-4 oraciones cortas que expliquen el problema de negocio y el resultado esperado.
Evita jerga innecesaria; si usas términos técnicos, hazlo en la sección técnica.

## Criterios de aceptación
- [ ] Criterio de negocio 1 (observable y verificable)
- [ ] Criterio de negocio 2
- [ ] Criterio de negocio 3
- [ ] os-vault-test pasa (todos los tests en verde)
- [ ] os-vault-test --coverage pasa (>= 90%)
- [ ] El contrato respeta las restricciones del sandbox Python de Vault

## Notas técnicas
- Hooks Vault: ...
- Tipos contracts_api: ...
- Archivos: contracts/<nombre>.py + tests/test_<nombre>.py

## Definición de terminado
- [ ] os-vault-test 100% verde
- [ ] Cobertura >= 90%
- [ ] PR revisado y aprobado
- [ ] Ticket Jira movido a Done

Reglas de estilo:
- Párrafos cortos (1-3 oraciones).
- Listas con un criterio por línea.
- No uses bloques de código salvo que sea imprescindible.
- No dejes marcadores markdown crudos fuera del formato de arriba."
  else
    HU_TEMPLATE="Write ONLY the user story content (no preamble).
Use this exact format, clear and easy to read in Jira:

## User Story
As a [role], I want [capability], so that [benefit].

## Context
2-4 short sentences explaining the business problem and expected outcome.
Keep jargon out of this section; put technical detail below.

## Acceptance Criteria
- [ ] Business criterion 1 (observable and testable)
- [ ] Business criterion 2
- [ ] Business criterion 3
- [ ] os-vault-test passes (all tests green)
- [ ] os-vault-test --coverage passes (>= 90%)
- [ ] Contract respects Vault Python sandbox restrictions

## Technical Notes
- Vault hooks: ...
- contracts_api types: ...
- Files: contracts/<name>.py + tests/test_<name>.py

## Definition of Done
- [ ] os-vault-test 100% green
- [ ] Coverage >= 90%
- [ ] PR reviewed and approved
- [ ] Jira ticket moved to Done

Style rules:
- Short paragraphs (1-3 sentences).
- One criterion per list line.
- Avoid code fences unless essential.
- Do not leave raw markdown markers outside the format above."
  fi

  PROMPT="Generate a complete Jira user story for a Vault Smart Contract project.

## Active Language
$OS_LANGUAGE_LABEL
$OS_LANGUAGE_DIRECTIVE

Title: $SUMMARY
Stack: vault-smart-contracts (Thought Machine Vault, API 4.0)
Project context: OpenSpec — spec-driven development framework for Vault Smart Contracts

$HU_TEMPLATE"

  PROMPT_FILE="${OS_REPO_ROOT}/.openspec-cli/.last-prompt.md"
  OUTPUT_FILE="${OS_REPO_ROOT}/.openspec-cli/.last-ai-output.md"
  echo "$PROMPT" > "$PROMPT_FILE"

  os_deliver_prompt_capture "$PROMPT_FILE" "$OUTPUT_FILE"
  DESCRIPTION=$(cat "$OUTPUT_FILE" 2>/dev/null || echo "")

  if [ -z "$DESCRIPTION" ]; then
    os_warn "AI did not return output. Paste description manually (CTRL+D to finish):"
    DESCRIPTION=$(cat)
  fi
else
  printf "Description (CTRL+D when done):\n"
  DESCRIPTION=$(cat)
  DESCRIPTION="${DESCRIPTION:-No description provided.}"
fi

# ── Create the ticket ─────────────────────────────────────────
os_jira_create_ticket "$PROJECT_KEY" "$SUMMARY" "$TYPE" "$DESCRIPTION"

os_divider
os_info "Next steps:"
os_info "  os-enrich  $CREATED_TICKET_KEY   # enrich with technical detail"
os_info "  os-plan    $CREATED_TICKET_KEY   # generate implementation plan"
os_info "  os-develop $CREATED_TICKET_KEY   # create branch + implement"
os_divider
