#!/usr/bin/bash
# os-vault-account — Create a test account in Vault linked to a product version
# v5: vuelve a instance_param_vals (nombre original, anidado dentro de
#     "account"), pero ahora con TODOS los parametros INSTANCE requeridos,
#     no solo denomination como en el intento original.
# v6: si se pasa instance_params_json, se usa TAL CUAL (sin inyectar la clave
#     'denomination') — necesario para contratos cuyo parametro se llama distinto
#     (p. ej. cuenta_nomina usa 'denominacion' en espanol).
# Usage: os-vault-account <product_version_id> <customer_id> [denomination] [instance_params_json]
#   os-vault-account 9660 <cust>                       # denomination=GBP auto
#   os-vault-account 9703 <cust> COP '{"denominacion":"COP"}'   # clave en espanol

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_CLI_LIB="${SCRIPT_DIR}/../lib"

source "${OS_CLI_LIB}/colors.sh"
source "${OS_CLI_LIB}/config.sh"
os_load_config
os_load_env

PRODUCT_VERSION_ID="${1:-}"
CUSTOMER_ID="${2:-}"
DENOMINATION="${3:-${VAULT_DEFAULT_DENOMINATION:-GBP}}"
if [ -z "${4:-}" ]; then
    INSTANCE_PARAMS_JSON="{}"
else
    INSTANCE_PARAMS_JSON="$4"
fi

if [ -z "${PRODUCT_VERSION_ID}" ] || [ -z "${CUSTOMER_ID}" ]; then
    os_print_error "Usage: os-vault-account <product_version_id> <customer_id> [denomination] [instance_params_json]"
    exit 1
fi

if [ -z "${VAULT_BASE_URL:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
    os_print_error "Missing Vault credentials. Add VAULT_BASE_URL and VAULT_TOKEN to .env"
    exit 1
fi

os_print_separator
os_print_header "OpenSpec — Vault Account Creation"
os_print_separator
os_print_info "Product version : ${PRODUCT_VERSION_ID}"
os_print_info "Customer        : ${CUSTOMER_ID}"
os_print_info "Denomination    : ${DENOMINATION}"
os_print_separator

PAYLOAD_FILE=$(mktemp /tmp/os-vault-account-XXXXXX.json)
RESULT_FILE=$(mktemp /tmp/os-vault-account-result-XXXXXX.json)
trap "rm -f ${PAYLOAD_FILE} ${RESULT_FILE}" EXIT

"${OS_PYTHON}" -c "
import json, sys, uuid

product_version_id = sys.argv[1]
customer_id = sys.argv[2]
denomination = sys.argv[3]
instance_params = json.loads(sys.argv[4])

# Si el caller da instance_params, es la fuente de verdad completa (nombres de
# parametro tal cual los declara el contrato). Solo cuando no da nada asumimos
# el contrato de KAN-12 con un unico INSTANCE llamado 'denomination'.
if instance_params:
    instance_param_vals = {k: str(v) for k, v in instance_params.items()}
else:
    instance_param_vals = {'denomination': denomination}

payload = {
    'request_id': str(uuid.uuid4()),
    'account': {
        'product_version_id': product_version_id,
        'name': 'OpenSpec Test Account',
        'stakeholder_ids': [customer_id],
        'permitted_denominations': [denomination],
        'status': 'ACCOUNT_STATUS_OPEN',
        'instance_param_vals': instance_param_vals
    }
}
print(json.dumps(payload, indent=2))
" "${PRODUCT_VERSION_ID}" "${CUSTOMER_ID}" "${DENOMINATION}" "${INSTANCE_PARAMS_JSON}" > "${PAYLOAD_FILE}"

cp "${PAYLOAD_FILE}" /tmp/last-account-payload.json

os_step "Calling POST /v1/accounts ..."

HTTP_STATUS=$(curl -s -o "${RESULT_FILE}" -w "%{http_code}" \
    -X POST \
    -H "X-Auth-Token: ${VAULT_TOKEN}" \
    -H "Content-Type: application/json" \
    -d @"${PAYLOAD_FILE}" \
    "${VAULT_BASE_URL}/v1/accounts")

if [ "${HTTP_STATUS}" != "200" ] && [ "${HTTP_STATUS}" != "201" ]; then
    os_print_error "Account creation failed (HTTP ${HTTP_STATUS}):"
    cat "${RESULT_FILE}" | "${OS_PYTHON}" -m json.tool 2>/dev/null || cat "${RESULT_FILE}"
    exit 1
fi

"${OS_PYTHON}" "${OS_CLI_LIB}/vault_account_print_result.py" "${RESULT_FILE}"

os_print_separator
